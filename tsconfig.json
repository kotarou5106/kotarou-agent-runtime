{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "baseUrl": ".",
    "paths": {
      "kotarou-dashboard": ["types/kotarou-dashboard.d.ts"]
    },
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["dashboard/frontend/src/**/*.ts", "dashboard/frontend/src/**/*.tsx", "plugins/**/*.ts", "types/**/*.d.ts"]
}
